{
    "name": "simple-load-script",
    "version": "2.2.0",
    "description": "Very simple promise based script and JSONP",
    "keywords": [
        "JSONP",
        "promise",
        "script"
    ],
    "license": "MIT",
    "author": "Tomek Fijoł <tomekfijol@gmail.com> (http://tomekf.pl/)",
    "contributors": [
        {
            "name": "Martin Jurča",
            "email": "martin.jurca@firma.seznam.cz"
        },
        {
            "name": "Tom Conroy",
            "url": "https://github.com/tconroy"
        }
    ],
    "repository": "tomek-f/simple-load-script",
    "source": "src/index.ts",
    "files": [
        "src",
        "dist",
        "CHANGELOG.md"
    ],
    "type": "module",
    "main": "./dist/index.umd.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "unpkg": "./dist/index.umd.js",
    "umd:main": "./dist/index.umd.js",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs",
            "default": "./dist/index.umd.js"
        }
    },
    "scripts": {
        "check-all": "pnpm lint && pnpm format-check && pnpm check-types && pnpm test-run",
        "prepublishOnly": "pnpm check-all && pnpm build",
        "build": "tsdown",
        "watch": "tsdown --watch",
        "lint": "NODE_ENV=production oxlint ./",
        "lint-fix": "NODE_ENV=production oxlint --fix ./",
        "test-run": "vitest run --reporter=verbose",
        "test-watch": "vitest --reporter=verbose",
        "format-check": "oxfmt --check",
        "format-write": "oxfmt --write",
        "check-types": "echo 'checking types…' && tsc && echo '…no type problems'",
        "__show-outdated": "pnpm outdated -r --no-table",
        "__update-package-recursive-example": "pnpm update -r --latest XXX",
        "__create-commit-push-deps-branch": "git cam 'feat: Update deps.' && git push -u",
        "__create-and-push-deps-branch": "git cob feat/deps && pnpm __create-commit-push-deps-branch",
        "__update-latest": "pnpm update -r --latest && pnpm dedupe && pnpm __create-and-push-deps-branch",
        "__update": "pnpm update -r && pnpm dedupe && pnpm __create-and-push-deps-branch"
    },
    "devDependencies": {
        "@types/jsdom": "28.0.3",
        "jsdom": "29.1.1",
        "oxfmt": "0.57.0",
        "oxlint": "1.72.0",
        "tsdown": "0.22.3",
        "typescript": "6.0.3",
        "vitest": "4.1.9"
    },
    "packageManager": "pnpm@11.9.0"
}
