{
    "name": "simple-load-script",
    "version": "2.2.0",
    "description": "Very simple promise based script and JSONP",
    "keywords": [
        "JSONP",
        "promise",
        "script"
    ],
    "license": "MIT",
    "author": "Tomek Fijoł <tomekfijol@gmail.com> (http://tomekf.pl/)",
    "contributors": [
        {
            "name": "Martin Jurča",
            "email": "martin.jurca@firma.seznam.cz"
        },
        {
            "name": "Tom Conroy",
            "url": "https://github.com/tconroy"
        }
    ],
    "repository": "tomek-f/simple-load-script",
    "source": "src/index.ts",
    "files": [
        "src",
        "dist",
        "CHANGELOG.md"
    ],
    "type": "module",
    "main": "./dist/index.umd.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "unpkg": "./dist/index.umd.js",
    "umd:main": "./dist/index.umd.js",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.cjs",
            "default": "./dist/index.umd.js"
        }
    },
    "scripts": {
        "check-all": "pnpm lint && pnpm format-check && pnpm check-types && pnpm test",
        "prepublishOnly": "pnpm check-all && pnpm build",
        "build": "tsdown",
        "watch": "tsdown --watch",
        "lint": "NODE_ENV=production oxlint ./",
        "lint-fix": "NODE_ENV=production oxlint --fix ./",
        "test": "NODE_ENV=test node --test ./test/*.test.ts",
        "test-ci": "NODE_ENV=test node --test --test-reporter=spec --test-reporter=junit --test-reporter-destination=stdout --test-reporter-destination=./test-reports/junit.xml ./test/*.test.ts",
        "test-watch": "NODE_ENV=test node --test --watch ./test/*.test.ts",
        "format-check": "oxfmt --check",
        "format-write": "oxfmt --write",
        "check-types": "echo 'checking types…' && tsc && echo '…no type problems'",
        "__show-latest-version-of-pnpm": "pnpm view pnpm",
        "__show-outdated": "pnpm outdated -r --no-table",
        "__update-package-recursive-latest-example": "echo 'pnpm update -r --latest <name-of-package>'",
        "__update-interactive-latest": "pnpm update --interactive -r --latest && pnpm dedupe",
        "__update-latest": "pnpm update -r --latest && pnpm dedupe",
        "__update-interactive": "pnpm update --interactive -r && pnpm dedupe",
        "__update": "pnpm update -r && pnpm dedupe",
        "__check-some-module": "pnpm dlx qnm typescript"
    },
    "devDependencies": {
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.2.0",
        "jsdom": "30.0.1",
        "oxfmt": "0.63.0",
        "oxlint": "1.78.0",
        "tsdown": "0.22.14",
        "typescript": "7.0.2"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "next-12",
            "onFail": "download"
        }
    },
    "engines": {
        "node": ">=26"
    },
    "packageManager": "pnpm@11.21.0"
}
