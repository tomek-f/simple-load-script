{
    "compilerOptions": {
        "target": "es2015",
        "module": "esnext",
        "moduleResolution": "bundler",
        "lib": ["dom", "dom.iterable", "esnext"],
        "declaration": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "isolatedDeclarations": true
    },
    "include": ["./**/*.ts"]
}
