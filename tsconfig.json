{
    "compilerOptions": {
        "target": "es2015",
        "module": "node16",
        "lib": ["es2015", "DOM"],
        "declaration": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "moduleResolution": "node16",
        "isolatedDeclarations": true,
    },
    "include": ["./**/*.ts"],
}
